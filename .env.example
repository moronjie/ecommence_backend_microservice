POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Per-service settings (copy into services/<name>/.env)
SERVICE_NAME=template-service
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/auth_db
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Gateway
JWT_SECRET=change-me-in-production
AUTH_URL=http://localhost:8001
TEMPLATE_URL=http://localhost:8100

# Auth service (JWT_SECRET must match the gateway's)
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Optional: an admin account is created on startup if both are set
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Notification service. "console" just logs emails; "smtp" sends them.
# Local development with Docker: emails are caught by Mailpit at http://localhost:8025
EMAIL_PROVIDER=console
SHOP_NAME=Our Shop
FROM_ADDRESS=shop@example.com
SUPPORT_EMAIL=support@example.com
# For a real provider (Brevo, Mailgun, SendGrid, Resend, Gmail... all offer SMTP):
# SMTP_HOST=smtp.example.com  SMTP_PORT=587  SMTP_USERNAME=...  SMTP_PASSWORD=...  SMTP_STARTTLS=true

# Payment service. "fake" needs no account; use "paystack" with a TEST key to try the real thing.
PAYMENT_PROVIDER=fake
PAYSTACK_SECRET_KEY=
# Where Paystack sends the customer after paying (your shop's thank-you page). Optional.
PAYMENT_CALLBACK_URL=
